# Copy this file to .env for local development (Railway uses its own
# Variables tab instead of this file — see README.md).

# Your bot's token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: paste a single server ID here while developing so slash
# commands sync instantly to that server instead of taking up to an hour
# to appear globally. Remove this variable before going public.
DEV_GUILD_ID=
